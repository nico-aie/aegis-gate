# =========================
# Rust / Cargo
# =========================
target/
**/target/
Cargo.lock

# Generated files
**/*.rs.bk

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo
*.iml
*.code-workspace

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs
# =========================
*.log
logs/
*.out

# =========================
# Environment / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Rust tooling caches
# =========================
/debug/
release/

# =========================
# Rust Analyzer cache
# =========================
.rust-analyzer/

# =========================
# WASM (nếu có)
# =========================
*.wasm

# =========================
# Benchmark / test artifacts
# =========================
/benches/output/node_modules/
# Top-level node_modules — used only for ad-hoc dev tools
# (e.g. Playwright for tests/dashboard/capture-screenshots.mjs).
/node_modules/
/package-lock.json

# =========================
# Local launchers / staging configs (operator-specific, contain secrets)
# =========================
/run-staging.cmd
/config/staging.yaml
# v2.3 binary contract — `make stage` artefacts (operator-local symlinks)
/waf
/waf.yaml
/waf_audit.log

# =========================
# Self-signed dev certs
# =========================
# Generated by `bash config/gen-cert.sh`. Never commit; replace with
# real certs (or wire ACME) before production use.
/config/certs/
.claude/
__pycache__

# =========================
# MaxMind GeoIP databases
# =========================
# Each operator populates `data/geoip/` locally via
# `make geoip-link`. See data/geoip/README.md for the why.
# /data/geoip/*.mmdb
# /data/geoip/*.tar.gz
# /data/geoip/GeoLite2-*/

# =========================
# Generated security corpora
# =========================
# The v4 adversarial dataset (~90 MB) is generator-derived, not
# hand-authored. The generator at
# tests/security/dataset/generator/generate_v4.py is the
# canonical source; run it locally with the default seed to
# regenerate byte-identical output in ~1.6s. Clean baselines
# (3 MB) DO go in — they're small enough.
/tests/security/dataset/attacks_v4.ndjson
/tests/security/dataset/attacks_v4.ndjson.gz

# =========================
# Raw l-tester recon dumps
# =========================
# 518KB+ raw recon path dumps capture scanned tokens (Atlassian JWTs)
# and trip GitHub push protection. Curated .md reports DO go in.
/tests/l-tester/reports/recon-path.txt
