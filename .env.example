# Aegis-Gate local env — copy to `.env` (gitignored) and fill in real values.
# `.env` is sourced by `make run-copilot`; secrets here are read at runtime
# and never committed. Rotate keys at the provider, then update `.env` only.

# --- AI Operator Copilot (LLM provider; OpenAI-compatible, e.g. vLLM) ---
LLM_ENABLED=true
LLM_BASE_URL=https://console.bizbrain.app/v1   # /chat/completions is appended
LLM_API_KEY=sk-REPLACE_ME                      # Bearer token — rotate at provider
LLM_MODEL=Qwen3.6-35B-A3B
LLM_TIMEOUT_MS=20000
# LLM_BRIEFING_INTERVAL_SECS=900   # >0 (>=60) enables scheduled briefings -> alerts

# --- OTLP traces -> SigNoz (override for a remote collector / SigNoz Cloud) ---
# WAF_OBSERVABILITY__OTEL__ENDPOINT=http://127.0.0.1:4317
# WAF_OBSERVABILITY__OTEL__SAMPLE_RATIO=1.0
