# Aegis-Gate local env — copy to `.env` (gitignored) and fill in real values.
# Sourced by `make run-copilot`; secrets here are read at runtime and never
# committed. Rotate keys at the provider, then update `.env` only.

# --- AI Operator Copilot — API key ---
# RECOMMENDED model (centralized config): put the copilot's non-secret
# settings in YAML under `observability.copilot` (see config/dev.yaml) and
# reference the key from there with `api_key_ref: "${secret:env:LLM_API_KEY}"`.
# Then only the KEY lives here:
LLM_API_KEY=sk-REPLACE_ME            # rotate at the provider; never paste in chat/tickets

# --- Legacy pure-env fallback (optional) ---
# If you don't set `observability.copilot.enabled: true` in YAML, the copilot
# falls back to building from these LLM_* vars (back-compat). Prefer the YAML
# model above.
# LLM_ENABLED=true
# LLM_BASE_URL=https://console.bizbrain.app/v1   # /chat/completions appended
# LLM_MODEL=Qwen3.6-35B-A3B
# LLM_TIMEOUT_MS=20000
# LLM_BRIEFING_INTERVAL_SECS=0   # >0 (>=60) enables scheduled briefings -> alerts

# --- OTLP traces -> SigNoz (override for a remote collector / SigNoz Cloud) ---
# WAF_OBSERVABILITY__OTEL__ENDPOINT=http://127.0.0.1:4317
# WAF_OBSERVABILITY__OTEL__SAMPLE_RATIO=1.0
