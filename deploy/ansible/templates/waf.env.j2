# MANAGED BY ANSIBLE — sourced before `./waf run` (see roles/waf_node).
LLM_API_KEY={{ llm_api_key }}
ORT_DYLIB_PATH={{ deploy_dir }}/runtime/onnxruntime/libonnxruntime.so
{% if copilot_enabled | default(false) %}
# Copilot (LLM) — CopilotService::from_env() requires ALL of these (the config
# block alone is not enough). Egress to LLM_BASE_URL happens only on a console
# briefing request (briefing_interval_secs: 0 = no auto-polling).
LLM_ENABLED=true
LLM_BASE_URL={{ copilot_base_url }}
LLM_MODEL={{ copilot_model }}
{% endif %}
