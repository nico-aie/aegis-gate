{
  "uid": "aegis-runtime",
  "title": "Aegis WAF — Runtime & Process",
  "description": "Tokio runtime, process resource use, and Prometheus self-stats. The Prometheus client library each WAF binary embeds exposes the standard process_* metrics (CPU, RSS, FDs, GC if any) on the same /metrics endpoint as the WAF-specific series. This dashboard covers what we get for free from `prometheus 0.13` plus a placeholder for tokio-runtime metrics that land once the `tokio_unstable` build flag is wired.",
  "tags": ["aegis", "runtime", "process"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "aegis-prometheus" }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(process_cpu_seconds_total{service=\"aegis-gate\"}, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Process CPU",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{service=\"aegis-gate\", instance=~\"$instance\"}[1m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 2,
      "title": "Process RSS",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{service=\"aegis-gate\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} rss",
          "refId": "A"
        },
        {
          "expr": "process_virtual_memory_bytes{service=\"aegis-gate\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} vsz",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 3,
      "title": "Open file descriptors",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "process_open_fds{service=\"aegis-gate\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} open",
          "refId": "A"
        },
        {
          "expr": "process_max_fds{service=\"aegis-gate\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}} max",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Process uptime",
      "type": "stat",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds{service=\"aegis-gate\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "value_and_name" }
    },
    {
      "id": 5,
      "title": "Tokio worker metrics (instrumentation pending)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Lights up once the `tokio_unstable` build flag is wired and `aegis_runtime_active_workers` / `aegis_runtime_blocking_queue_depth` series ship. Until then this panel renders empty — the dashboard slot is reserved.",
      "targets": [
        { "expr": "aegis_runtime_active_workers", "legendFormat": "active workers", "refId": "A" },
        { "expr": "aegis_runtime_blocking_queue_depth", "legendFormat": "blocking queue", "refId": "B" }
      ]
    }
  ]
}
