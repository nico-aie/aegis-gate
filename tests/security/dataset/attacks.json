{
  "_meta": {
    "version": "1.0",
    "created": "2026-05-08",
    "contract": "EN_waf_interop_contract_v2.3",
    "description": "Diverse attack payload dataset for Aegis-Gate WAF security testing. Each entry is a self-contained test case with expected detection class, acceptable actions per §3.1, and a unique ID for correlation.",
    "acceptable_actions_reference": {
      "high_confidence_injection": ["block", "challenge"],
      "auth_abuse": ["rate_limit", "challenge", "block"],
      "volumetric": ["rate_limit", "block"],
      "recon": ["block", "rate_limit", "challenge"],
      "known_bad_ip": ["block"]
    }
  },

  "sqli": {
    "class": "sqli",
    "contract_section": "§3.1 — High-confidence injection",
    "acceptable_actions": ["block", "challenge"],
    "cases": [
      {
        "id": "sqli-001",
        "label": "Classic UNION SELECT",
        "method": "GET",
        "path": "/search",
        "query": "q=UNION+SELECT+null,version(),null--",
        "headers": {},
        "notes": "Canonical SQL injection via UNION — high confidence"
      },
      {
        "id": "sqli-002",
        "label": "Boolean-based blind",
        "method": "GET",
        "path": "/login",
        "query": "u=admin'+OR+1=1--",
        "headers": {},
        "notes": "Boolean blind injection in login parameter"
      },
      {
        "id": "sqli-003",
        "label": "Time-based blind (SLEEP)",
        "method": "GET",
        "path": "/product",
        "query": "id=1;SELECT+SLEEP(5)--",
        "headers": {},
        "notes": "Time-delay injection"
      },
      {
        "id": "sqli-004",
        "label": "Stacked queries",
        "method": "GET",
        "path": "/item",
        "query": "id=1;DROP+TABLE+users--",
        "headers": {},
        "notes": "Multi-statement injection"
      },
      {
        "id": "sqli-005",
        "label": "POST body JSON injection",
        "method": "POST",
        "path": "/api/login",
        "query": "",
        "body": "{\"username\":\"admin' OR '1'='1\",\"password\":\"x\"}",
        "content_type": "application/json",
        "headers": {},
        "notes": "SQLi in JSON POST body"
      },
      {
        "id": "sqli-006",
        "label": "UNION with column count probe",
        "method": "GET",
        "path": "/report",
        "query": "id=1+UNION+SELECT+1,2,3--",
        "headers": {},
        "notes": "Column count enumeration"
      },
      {
        "id": "sqli-007",
        "label": "Comment-based evasion",
        "method": "GET",
        "path": "/item",
        "query": "id=1/**/UNION/**/SELECT/**/null--",
        "headers": {},
        "notes": "Inline comment evasion of simple pattern match"
      },
      {
        "id": "sqli-008",
        "label": "URL-encoded evasion",
        "method": "GET",
        "path": "/search",
        "query": "q=1%27%20OR%20%271%27%3D%271",
        "headers": {},
        "notes": "URL-encoded single-quote evasion"
      },
      {
        "id": "sqli-009",
        "label": "Error-based via extractvalue",
        "method": "GET",
        "path": "/product",
        "query": "id=extractvalue(1,concat(0x7e,version()))",
        "headers": {},
        "notes": "MySQL error-based exfiltration"
      },
      {
        "id": "sqli-010",
        "label": "Header injection — User-Agent",
        "method": "GET",
        "path": "/api/users",
        "query": "",
        "headers": {"User-Agent": "' UNION SELECT 1,2,3--"},
        "notes": "SQLi via User-Agent header"
      }
    ]
  },

