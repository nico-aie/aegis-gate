        "id": "xss-007",
        "label": "Encoded angle brackets",
        "method": "GET",
        "path": "/search",
        "query": "q=%3Cscript%3Ealert%281%29%3C%2Fscript%3E",
        "headers": {},
        "notes": "URL-encoded XSS evasion attempt"
      },
      {
        "id": "xss-008",
        "label": "POST body reflected",
        "method": "POST",
        "path": "/comment",
        "query": "",
        "body": "text=<script>alert(document.domain)</script>",
        "content_type": "application/x-www-form-urlencoded",
        "headers": {},
        "notes": "XSS in POST body form field"
      },
      {
        "id": "xss-009",
        "label": "Expression injection (template)",
        "method": "GET",
        "path": "/template",
        "query": "name={{7*7}}",
        "headers": {},
        "notes": "SSTI / template injection probe"
      },
      {
        "id": "xss-010",
        "label": "AngularJS sandbox escape",
        "method": "GET",
        "path": "/ng",
        "query": "input={{constructor.constructor('alert(1)')()}}",
        "headers": {},
        "notes": "AngularJS sandbox escape"
      }
    ]
  },

  "path_traversal": {
